<h3>Add a comment:</h3>
<%= form_with model: [ @post, @post.comments.build ] do |form| %>
  <div>
    <%= form.label :author_name, "Naam" %>
    <%= form.text_field :author_name, placeholder: "Naam (of je geheime alias)", required: true %>

    <%= form.label :author_email, "E-mail (wordt niet getoond)" %>
    <%= form.email_field :author_email, placeholder: "user@example.com" %>

    <%= form.label :author_website, "Website (optioneel)" %>
    <%= form.url_field :author_website, placeholder: "https://github.com[username]" %>

    <%= form.label :body, "Bericht" %>
    <%= form.text_area :body, placeholder: "Bericht" %><br>

  <%# De Honeypot: verborgen voor mensen, verleidelijk voor bots %>
    <div style="display:none;">
      <label>Niet invullen:</label>
      <input type="text" name="comment[nickname]">
    </div>

    <%= form.submit "Verzenden" %>
  </div>
<% end %>
