
<p style="color: green"><%= notice %></p>

<% content_for :title, "Posts" %>

<h1>Posts</h1>

<section aria-label="Latest Posts" id="posts">
  <% @posts.each do |post| %>
    <article>
      <h2>
        <%= link_to post.title, post %>
      </h2>
      <%= time_tag post.created_at, "data-local": "time", "data-format": "%e %B %Y" %>
    </article>
  <% end %>
</section>

<section aria-label="Post Tools" id="tools">
  <%= link_to "New post", new_post_path %>
</section>
