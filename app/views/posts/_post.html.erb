<article id="<%= dom_id post %>">

  <header>
    <h1><%= post.title %></h1>
    <p id="excerpt"><%= post.excerpt %></p>
    <%= time_tag post.created_at, "data-local": "time", "data-format": "%e %B %Y" %>
  </header>

  <%= post.body %>

  <%= render "comments/comments", post: @post %>

</article>
